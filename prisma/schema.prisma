// SQLite is used so the project runs with zero external setup.
// Swapping to PostgreSQL/MySQL means changing `provider` + `DATABASE_URL`;
// no application code depends on the engine (see src/lib/repositories).

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Project {
  id          Int      @id @default(autoincrement())
  clientName  String
  projectName String
  description String   @default("")

  // Stored as strings rather than native enums: SQLite has no enum type.
  // The allowed values live in one place (src/lib/validation/project.ts) and
  // are enforced before anything reaches the database.
  status   String
  priority String

  // Date-only values, persisted at UTC midnight so they never shift timezone.
  startDate DateTime
  dueDate   DateTime

  // Derived sort keys. Ordering by these columns alphabetically would give
  // High, Low, Medium and Completed, In Progress, On Hold, Planning — both
  // meaningless. The ranks let the database sort by severity and by where the
  // project sits in its lifecycle.
  //
  // The `0` default is a sentinel no real row keeps: the repository sets both
  // ranks on every write. It exists so the column can be added to a database
  // that already has rows — without it, `prisma db push` refuses to add a
  // required column to a non-empty table.
  priorityRank Int @default(0)
  statusRank   Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([priority])
  @@index([dueDate])
}
